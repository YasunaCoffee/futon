---
// 話の画像を横にスワイプして1枚ずつ読む(shelves.yaml の page.swipe: true)。
// ltr は左から右へ、rtl は漫画の向きで右から左へ並べる。スマホは指で、PCは矢印ボタンかキーで送る。下の点で今何枚目かが分かる。
import { url } from "@futon/lib/content";
import { tr } from "@futon/lib/i18n";
interface Props { images: { src: string; alt: string }[]; dir?: "ltr" | "rtl" }
const { images, dir = "ltr" } = Astro.props;
const rtl = dir === "rtl";
---
<div class="fswipe" dir={dir}>
  {/* 矢印は dir="ltr" で包む(rtl の中だと ‹ › → が鏡写しになる) */}
  <div class="fswipe-track" tabindex="0" aria-label={tr("スワイプで次へ")}>
    {images.map((i, n) => <figure class="fswipe-slide" aria-label={`${n + 1} / ${images.length}`}><img src={url(i.src)} alt={i.alt} loading={n ? "lazy" : undefined}></figure>)}
  </div>
  <button class="fswipe-btn prev" type="button" dir="ltr" aria-label={tr("まえへ")} hidden>{rtl ? "›" : "‹"}</button>
  <button class="fswipe-btn next" type="button" dir="ltr" aria-label={tr("つぎへ")}>{rtl ? "‹" : "›"}</button>
  <div class="fswipe-dots">{images.map((_, n) => <button type="button" aria-label={`${n + 1}`} class={n ? "" : "on"}></button>)}</div>
  <p class="fswipe-hint" dir="ltr">{rtl ? tr("スワイプで次へ →") : tr("← スワイプで次へ")}</p>
</div>

<style>
  .fswipe{position:relative;max-width:560px;margin:0 auto}
  .fswipe-track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;-webkit-overflow-scrolling:touch;scrollbar-width:none;outline:none}
  .fswipe-track::-webkit-scrollbar{display:none}
  .fswipe-slide{flex:0 0 100%;margin:0;scroll-snap-align:center;display:flex;justify-content:center;align-items:flex-start}
  .fswipe-slide img{width:100%;height:auto;display:block}
  .fswipe-btn{position:absolute;top:50%;transform:translateY(-50%);width:36px;height:36px;border-radius:50%;border:0;background:rgba(0,0,0,.45);color:#fff;font-size:24px;line-height:36px;padding:0;cursor:pointer}
  .fswipe-btn.prev{inset-inline-start:6px}
  .fswipe-btn.next{inset-inline-end:6px}
  .fswipe-btn[hidden]{display:none}
  .fswipe-dots{display:flex;justify-content:center;gap:8px;margin:8px 0 2px}
  .fswipe-dots button{width:9px;height:9px;border-radius:50%;border:0;padding:0;background:#ccc;cursor:pointer}
  .fswipe-dots button.on{background:#555}
  .fswipe-hint{text-align:center;font-size:12px;opacity:.6;margin:2px 0 0}
</style>

<script>
  for (const box of document.querySelectorAll<HTMLElement>(".fswipe")) {
    const track = box.querySelector<HTMLElement>(".fswipe-track")!;
    const slides = [...track.children] as HTMLElement[];
    const dots = [...box.querySelectorAll<HTMLButtonElement>(".fswipe-dots button")];
    const prev = box.querySelector<HTMLButtonElement>(".prev")!, next = box.querySelector<HTMLButtonElement>(".next")!;
    const hint = box.querySelector<HTMLElement>(".fswipe-hint")!;
    const sign = box.dir === "rtl" ? -1 : 1; // 右から左のときは scrollLeft が 0 から負の向きに進む
    const now = () => Math.round(Math.abs(track.scrollLeft) / track.clientWidth);
    const go = (n: number) => track.scrollTo({ left: sign * Math.max(0, Math.min(slides.length - 1, n)) * track.clientWidth });
    const paint = () => {
      const n = now();
      dots.forEach((d, i) => d.classList.toggle("on", i === n));
      prev.hidden = n === 0; next.hidden = n === slides.length - 1;
      if (n > 0) hint.style.visibility = "hidden";
    };
    track.addEventListener("scroll", () => requestAnimationFrame(paint), { passive: true });
    prev.addEventListener("click", () => go(now() - 1));
    next.addEventListener("click", () => go(now() + 1));
    dots.forEach((d, i) => d.addEventListener("click", () => go(i)));
    track.addEventListener("keydown", (e) => { const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0; if (d) go(now() + d * sign); });
    paint();
  }
</script>
