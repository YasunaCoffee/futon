---
// OGP と X のカード。画像は futon/public からの道(img/…)で受け取り、site.json の url で絶対URLにする。
// url が無いと X などは画像を拾えないので、そのときは og:image を出さない。
// 画像が無いページは site.json の ogImage を使う。ファイルが無い道は出さない。
import fs from "node:fs";
import { url, site } from "@futon/lib/content";
import { futonPath } from "@futon/lib/futon";
interface Props { title: string; description?: string; image?: string }
const { title, description, image } = Astro.props;
const abs = (p: string) => (site.url ? new URL(url(p), site.url).href : undefined);
const exists = (p?: string) => !!p && (/^https?:/.test(p) || fs.existsSync(futonPath("public", p.replace(/^\//, ""))));
const pick = [image, site.ogImage].find(exists);
const img = pick && (/^https?:/.test(pick) ? pick : abs(pick));
const page = abs(Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), ""));
---
<meta property="og:title" content={title}>
{description && <meta property="og:description" content={description}>}
<meta property="og:type" content="website">
<meta property="og:site_name" content={site.title}>
{page && <meta property="og:url" content={page}>}
{img && <meta property="og:image" content={img}>}
<meta name="twitter:card" content={img ? "summary_large_image" : "summary"}>
