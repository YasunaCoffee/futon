---
// mado テーマの話のページ。props:s(棚)・e(話)・newer / older
import { tabOf } from "@futon/lib/series";
import Base from "./Base.astro";
import Cast from "./Cast.astro";
import Hana from "./Hana.astro";
import Share from "@futon/components/Share.astro";
import Tweet from "@futon/components/Tweet.astro";
import { dotted, url, castOf } from "@futon/lib/content";
const { s, e, newer, older } = Astro.props;
const d = e.data;
const p = s.page(d);
const cast = castOf(p.cast);
---
<Base title={p.title} tab={tabOf(s)} description={p.description}>
  <p class="small"><a href={url(`${s.key}/`)}>{s.name}</a></p>
  <h1 class="big">{d.title}</h1>
  <p class="meta">{dotted(d.date)} ／ {p.meta}{p.kind && ` ／ ${p.kind}`}</p>
  <Hana />
  <div class="imgs">{p.images.map((i) => <img src={url(i.src)} alt={i.alt}>)}</div>
  {p.kessho && <p class="verse">{p.kessho.lines.map((l, i) => <>{i > 0 && <br />}{l}</>)}<small>{p.kessho.source}</small></p>}
  {cast.length > 0 && <p class="memo">この話に出てくる人 <Cast list={cast} size={36} /></p>}
  {d.x && <Tweet url={d.x} note="Xでのようす" />}
  <Share text={p.share} />
  <Hana />
  <p class="pager">
    {older ? <a href={url(`${s.key}/${older.data.num}/`)}>≪まえのおはなし</a> : <span></span>}
    <a href={url(`${s.key}/`)}>もくじ</a>
    {newer ? <a href={url(`${s.key}/${newer.data.num}/`)}>つぎのおはなし≫</a> : <span></span>}
  </p>
</Base>
