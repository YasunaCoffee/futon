---
// mado テーマのホーム:いらっしゃいませ・新作登場・棚・キャラクター・本・記事・まなーぶっく
import Base from "./Base.astro";
import Cast from "./Cast.astro";
import Hana from "./Hana.astro";
import { episodes, techPosts, newest, md, dotted, url, site, characters, books, booksOf } from "@futon/lib/content";
import { series } from "@futon/lib/series";
const shelves = await Promise.all(series.map(async (s) => ({ s, eps: (await episodes(s.key)).slice(0, 4) })));
const items = (await newest()).filter((i) => i.kind !== "video").slice(0, 6);
const techs = (await techPosts()).slice(0, 5);
---
<Base tab="home">
  <p class="small">{site.owner && `${site.owner}の`}</p>
  <h1 class="big">{site.title}</h1>
  <Hana />
  {site.hello && <p class="welcome" set:html={site.hello} />}
  {site.intro && (
    <section class="intro">
      <h2>{site.intro.heading}</h2>
      {site.intro.image && <img src={url(site.intro.image)} alt="">}
      {site.intro.paragraphs?.map((p: string) => <p set:html={p} />)}
      {site.intro.dream && <p class="dream" set:html={site.intro.dream} />}
    </section>
  )}
  <Hana />
  {items.length > 0 && (
    <section>
      <h2>新作登場!!</h2>
      <ul class="news">{items.map((i) => <li><span class="d">{md(i.date)}</span> <a href={i.href}>{i.label}:{i.title}</a>{i === items[0] && <b class="new">NEW!</b>}</li>)}</ul>
    </section>
  )}
  {shelves.filter((x) => x.eps.length).map(({ s, eps }) => (
    <section>
      <h2>{s.name}</h2>
      <div class="cards">
        {eps.map((e) => { const c = s.card(e.data); return <a class="card" href={url(`${s.key}/${e.data.num}/`)}><img src={url(c.thumb)} alt="" loading="lazy"><span>{e.data.title}</span><small>{c.sub}</small></a>; })}
      </div>
      <p class="more"><a href={url(`${s.key}/`)}>もっと見る ≫</a></p>
    </section>
  ))}
  {characters.length > 0 && (
    <section id="chars">
      <h2>キャラクターしょうかい</h2>
      <div class="chars">
        {characters.map((c) => (
          <table class="chr" id={c.slug && `chr-${c.slug}`}>
            <tbody>
              <tr><td class="pic" rowspan="2"><img src={url(c.image)} alt={c.name} loading="lazy"></td><th>{c.name}{c.tag && <small>({c.tag})</small>}</th></tr>
              <tr><td>
                <p>{c.text}</p>
                {c.facts && <p class="facts">{c.facts.map(([k, v]: string[]) => <>{k}:{v}<br /></>)}</p>}
                {c.fanart && <p class="note">{c.fanart.ok} {c.fanart.tags} {c.fanart.note} {c.fanart.link && <a href={url(c.fanart.link)}>ガイドライン</a>}</p>}
                {booksOf(c.slug).length > 0 && <p class="note">でてくる本 {booksOf(c.slug).map((b) => <a href={`#${b.id}`}>『{b.title}{b.sub}』</a>)}</p>}
                <p class="links">
                  {c.link && <a href={url(c.link)}>≫よむ</a>}
                  {c.site && <a href={c.site} target="_blank" rel="noopener">≫公式サイト</a>}
                  {c.x && <a href={c.x} target="_blank" rel="noopener">≫X</a>}
                </p>
              </td></tr>
            </tbody>
          </table>
        ))}
      </div>
    </section>
  )}
  {books.length > 0 && (
    <section id="books">
      <h2>本のおみせ</h2>
      <div class="books">
        {books.map((b) => (
          <div class="bk" id={b.id}>
            <img src={url(b.image)} alt={`『${b.title}${b.sub}』の表紙`} loading="lazy">
            <b>{b.title}<br>{b.sub}</b>
            {b.cast.length > 0 && <Cast list={b.cast} size={24} />}
            <span class="yen">¥{b.price.toLocaleString()}</span>
            {site.store && <a class="btn" href={site.store} target="_blank" rel="noopener">{site.storeButton ?? "ストアで見る"}</a>}
          </div>
        ))}
      </div>
    </section>
  )}
  {techs.length > 0 && (
    <section>
      <h2>{site.tech?.label ?? "記事"}</h2>
      <ul class="news">{techs.map((p) => <li><span class="d">{dotted(p.data.date)}</span> <a href={url(`tech/${p.id}/`)}>{p.data.emoji && `${p.data.emoji} `}{p.data.title}</a></li>)}</ul>
      <p class="more"><a href={url("tech/")}>もっと見る ≫</a></p>
    </section>
  )}
  <Hana />
  <div class="manner">
    <p class="mh">まなーぶっく</p>
    <p>絵や文章の無断転載はしないでね。<br>リンクは自由だよ。<a href={url("rss.xml")}>RSS</a> もあるよ。</p>
  </div>
</Base>
