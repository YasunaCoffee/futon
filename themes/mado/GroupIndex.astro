---
// mado テーマのグループのページ(いくつかの棚をまとめたもの)。props:g(グループ)
import Base from "./Base.astro";
import Hana from "./Hana.astro";
import { episodes, url } from "@futon/lib/content";
import { tr } from "@futon/lib/i18n";
const { g } = Astro.props;
const shelves = await Promise.all(g.shelves.map(async (s: any) => ({ s, eps: (await episodes(s.key)).slice(0, 8) })));
---
<Base title={g.name} tab={g.key}>
  <h1 class="big">{g.name}</h1>
  <Hana />
  {g.lead && <p class="welcome">{g.lead}</p>}
  {shelves.map(({ s, eps }) => (
    <section>
      <h2>{s.name}</h2>
      <div class="cards">
        {eps.map((e: any) => { const c = s.card(e.data); return <a class="card" href={url(`${s.key}/${e.data.num}/`)}><img src={url(c.thumb)} alt="" loading="lazy"><span>{e.data.title}</span><small>{c.sub}</small></a>; })}
      </div>
      <p class="more"><a href={url(`${s.key}/`)}>{tr("もっと見る ≫")}</a></p>
    </section>
  ))}
</Base>
