---
// mado テーマの 404。むかしのブラウザの「ページを表示できません」
import Base from "./Base.astro";
import { url } from "@futon/lib/content";
import { tr } from "@futon/lib/i18n";
---
<Base title={tr("ページを表示できません")} tab="" err>
  <div class="e404">
    <p class="ico" aria-hidden="true">⚠</p>
    <h1>{tr("ページを表示できません")}</h1>
    <p>{tr("探しているページは、まだ眠っているか、名前が変わったか、なくなったみたいです。")}</p>
    <hr>
    <p>{tr("次のことを試してください:")}</p>
    <ul>
      <li><a href={url("/")}>{tr("ホーム")}</a>{tr("を開いて、そこからリンクをたどる。")}</li>
      <li>{tr("[戻る] ボタンで前のページに戻る。")}</li>
    </ul>
    <p class="code">{tr("HTTP 404 - ファイルが見つかりません")}<br>{tr("ふとん Explorer")}</p>
  </div>
</Base>
