---
// kaomoji テーマのホーム:ひとこと・新着(チャット)・棚・キャラ・本・記事。欄はひとつずつ小さな窓
import Base from "./Base.astro";
import Cast from "./Cast.astro";
import { episodes, techPosts, newest, md, dotted, url, site, characters, books, booksOf } from "@futon/lib/content";
import { series } from "@futon/lib/series";
const shelves = await Promise.all(series.map(async (s) => ({ s, eps: (await episodes(s.key)).slice(0, 6) })));
const items = (await newest()).filter((i) => i.kind !== "video").slice(0, 6);
const techs = (await techPosts()).slice(0, 5);
const faces = ["(｡•ω•｡)", "(*´∀｀*)", "(o^∇^o)", "(・ω・)ﾉ", "(＾▽＾)", "(´・ω・`)"];
---
<Base tab="home">
  {site.intro && (
    <section class="intro">
      {site.intro.image && <img src={url(site.intro.image)} alt="">}
      <div class="bub big">
        <h1>{site.intro.heading}</h1>
        {site.intro.paragraphs?.map((p: string) => <p set:html={p} />)}
        {site.intro.dream && <p class="dream" set:html={site.intro.dream} />}
      </div>
    </section>
  )}
  {items.length > 0 && (
    <section class="win pink">
      <div class="bar"><span>✦ しんちゃく</span><a href={url("rss.xml")}>RSS</a></div>
      <ul class="chat">
        {items.map((i, n) => <li><span class="face" aria-hidden="true">{faces[n % faces.length]}</span><a class="bub" href={i.href}><small>{md(i.date)} ・ {i.label}</small>{i.title}</a></li>)}
      </ul>
    </section>
  )}
  {shelves.filter((x) => x.eps.length).map(({ s, eps }, n) => (
    <section class={`win ${n % 2 ? "pink" : "blue"}`}>
      <div class="bar"><span>{s.key}/</span><a href={url(`${s.key}/`)}>ぜんぶ見る ▶</a></div>
      <h2>{s.name}</h2>
      <div class="cards">
        {eps.map((e) => { const c = s.card(e.data); return <a class="card" href={url(`${s.key}/${e.data.num}/`)}><img src={url(c.thumb)} alt="" loading="lazy"><b>{e.data.title}</b><small>{c.sub}</small></a>; })}
      </div>
    </section>
  ))}
  {characters.length > 0 && (
    <section class="win blue" id="chars">
      <div class="bar"><span>characters/</span><b aria-hidden="true">♡</b></div>
      <h2>キャラクター</h2>
      <div class="chars">
        {characters.map((c) => (
          <div class="chr" id={c.slug && `chr-${c.slug}`}>
            <div class="pic"><img src={url(c.image)} alt={c.name} loading="lazy"></div>
            <div class="bub">
              <b class="name">{c.name}</b>{c.tag && <span class="kind">{c.tag}</span>}
              <p>{c.text}</p>
              {c.facts && <dl class="prof">{c.facts.map(([k, v]: string[]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>}
              {c.fanart && <p class="note"><b>{c.fanart.ok}</b> {c.fanart.tags} {c.fanart.note} {c.fanart.link && <a href={url(c.fanart.link)}>ガイドライン ▶</a>}</p>}
              {booksOf(c.slug).length > 0 && <p class="note">でてくる本 {booksOf(c.slug).map((b) => <a href={`#${b.id}`}>『{b.title}{b.sub}』</a>)}</p>}
              <p class="links">
                {c.link && <a class="btn" href={url(c.link)}>よむ ▶</a>}
                {c.site && <a class="btn" href={c.site} target="_blank" rel="noopener">公式サイト ↗</a>}
                {c.x && <a class="btn" href={c.x} target="_blank" rel="noopener">X ↗</a>}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}
  {books.length > 0 && (
    <section class="win pink" id="books">
      <div class="bar"><span>books/</span>{site.store && <a href={site.store} target="_blank" rel="noopener">ストア ↗</a>}</div>
      <h2>本</h2>
      <div class="books">
        {books.map((b) => (
          <div class="bk" id={b.id}>
            <img src={url(b.image)} alt={`『${b.title}${b.sub}』の表紙`} loading="lazy">
            <b>{b.title}<br>{b.sub}</b>
            {b.cast.length > 0 && <Cast list={b.cast} size={26} />}
            <span class="yen">¥{b.price.toLocaleString()}</span>
            {site.store && <a class="btn" href={site.store} target="_blank" rel="noopener">{site.storeButton ?? "ストアで見る"}</a>}
          </div>
        ))}
      </div>
    </section>
  )}
  {techs.length > 0 && (
    <section class="win blue">
      <div class="bar"><span>{site.tech?.tab ?? "記事"}.txt</span><a href={url("tech/")}>ぜんぶ見る ▶</a></div>
      <h2>{site.tech?.label ?? "記事"}</h2>
      <ul class="list">{techs.map((p) => <li><span class="d">{dotted(p.data.date)}</span><a href={url(`tech/${p.id}/`)}>{p.data.emoji && `${p.data.emoji} `}{p.data.title}</a></li>)}</ul>
    </section>
  )}
</Base>
