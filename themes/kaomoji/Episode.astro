---
// kaomoji テーマの話のページ。props:s(棚)・e(話)・newer / older
import { tabOf } from "@futon/lib/series";
import Base from "./Base.astro";
import Cast from "./Cast.astro";
import Share from "@futon/components/Share.astro";
import Tweet from "@futon/components/Tweet.astro";
import { dotted, url, castOf } from "@futon/lib/content";
const { s, e, newer, older } = Astro.props;
const d = e.data;
const p = s.page(d);
const cast = castOf(p.cast);
---
<Base title={p.title} tab={tabOf(s)} description={p.description}>
  <p class="crumb"><a href={url(`${s.key}/`)}>{s.name}</a> ▶ {p.crumb}</p>
  <h1 class="ttl">{d.title}{p.kind && <span class="kind">{p.kind}</span>}</h1>
  <p class="meta">{dotted(d.date)} ・ {p.meta}</p>
  <div class="imgs">{p.images.map((i) => <img src={url(i.src)} alt={i.alt}>)}</div>
  {p.kessho && <p class="bub verse">{p.kessho.lines.map((l, i) => <>{i > 0 && <br />}{l}</>)}<small>{p.kessho.source}</small></p>}
  {cast.length > 0 && <p class="memo">この話に出てくる人 <Cast list={cast} size={40} /></p>}
  {d.x && <Tweet url={d.x} note="Xでのようす" />}
  <Share text={p.share} />
  <div class="pager">
    {older ? <a class="btn" href={url(`${s.key}/${older.data.num}/`)}>◀ まえ</a> : <span></span>}
    {newer ? <a class="btn" href={url(`${s.key}/${newer.data.num}/`)}>つぎ ▶</a> : <a class="btn" href={url(`${s.key}/`)}>いちらん</a>}
  </div>
</Base>
