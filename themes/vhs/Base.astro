---
// vhs テーマの外枠。ビデオの再生画面(PLAY・カウンタ)と MENU、下にリモコンの操作説明
import "./style.css";
import { url, site, today, menuNav, extAttrs } from "@futon/lib/content";
import { shelfNav } from "@futon/lib/series";
import { hasTech } from "@futon/lib/futon";
import Analytics from "@futon/components/Analytics.astro";
import { tr, lang } from "@futon/lib/i18n";
interface Props { title?: string; description?: string; tab?: string; image?: string; err?: boolean }
const { title, description = site.description, tab = "home", image, err = false } = Astro.props;
const full = title ? `${title} | ${site.title}` : site.title;
const nav = [
  ["home", tr("ホーム"), url("/")],
  ...shelfNav(url),
  ...(hasTech ? [["tech", site.tech?.tab ?? tr("記事"), url("tech/")]] : []),
  ...(site.characters?.length ? [["chars", tr("キャラ"), url("/#chars")]] : []),
  ...(site.books?.length ? [["books", tr("本"), url("/#books")]] : []),
  ["about", tr("について"), url("about/")], ...menuNav(url),
];
---
<!doctype html>
<html lang={lang} class={err ? "err" : undefined}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  {site.noindex && <meta name="robots" content="noindex,nofollow">}
  <title>{full}</title>
  <meta name="description" content={description}>
  <meta property="og:title" content={full}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  {image && <meta property="og:image" content={image}>}
  <link rel="alternate" type="application/rss+xml" title={site.title} href={url("rss.xml")}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DotGothic16&family=VT323&display=swap">
  <Analytics />
</head>
<body class={err ? "err" : undefined}>
  <div class="screen">
    <div class="osd" aria-hidden="true"><span class="play">▶ PLAY</span><span>SP</span><span class="ctr">{today.replaceAll("-", ".")}</span></div>
    <header class="hd">
      <a class="logo" href={url("/")}><mark>{site.title}</mark></a>
      {site.hello && <p class="hello"><mark set:html={site.hello} /></p>}
    </header>
    <nav class="menu" aria-label={tr("メニュー")}>
      <p class="rule" aria-hidden="true"><span>MENU</span></p>
      <div>
        {nav.map(([k, label, href]) => <a class={tab === k ? "on" : undefined} href={href} {...extAttrs(href)}>{label}</a>)}
        {site.store && <a href={site.store} target="_blank" rel="noopener">{tr("ストア ↗")}</a>}
      </div>
      <p class="rule" aria-hidden="true"></p>
    </nav>
    <main class="page"><slot /></main>
    <footer class="ft">
      <dl class="keys">
        <dt>SELECT</dt><dd>:▲▼ <a href={url("rss.xml")}>RSS</a></dd>
        <dt>SET</dt><dd>:▶ <a href={url("privacy/")}>{tr("このサイトについて")}</a></dd>
        <dt>END</dt><dd>:■ {site.owner && <a href={url("about/")}>{site.owner}</a>}</dd>
      </dl>
      <small>{site.copyright}{site.since && ` ／ ${site.since.label} since ${site.since.date}`}</small>
    </footer>
  </div>
</body>
</html>
