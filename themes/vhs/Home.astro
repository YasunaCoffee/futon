---
// vhs テーマのホーム:ひとこと・新着・棚(チャプター)・キャラ(PLAYER SELECT)・本(SHOP)・記事
import Base from "./Base.astro";
import Cast from "./Cast.astro";
import { episodes, techPosts, newest, md, dotted, url, site, characters, books, booksOf } from "@futon/lib/content";
import { series } from "@futon/lib/series";
import { tr } from "@futon/lib/i18n";
const shelves = await Promise.all(series.map(async (s) => ({ s, eps: (await episodes(s.key)).slice(0, 6) })));
const items = (await newest()).filter((i) => i.kind !== "video").slice(0, 8);
const techs = (await techPosts()).slice(0, 5);
const no = (n: number) => String(n).padStart(2, "0");
let ch = 0;
---
<Base tab="home">
  {site.intro && (
    <section class="intro">
      {site.intro.image && <img src={url(site.intro.image)} alt="">}
      <div>
        <h1><mark>{site.intro.heading}</mark></h1>
        {site.intro.paragraphs?.map((p: string) => <p set:html={p} />)}
        {site.intro.dream && <p class="dream"><mark set:html={site.intro.dream} /></p>}
      </div>
    </section>
  )}
  {items.length > 0 && (
    <section>
      <h2><span>[{no(++ch)}]</span> <mark>NEW ARRIVAL</mark><a href={url("rss.xml")}>RSS ▶</a></h2>
      <ul class="lines">
        {items.map((i) => <li><span class="d">{md(i.date)}</span><span class="g">{i.label}</span><a href={i.href}>{i.title}</a></li>)}
      </ul>
    </section>
  )}
  {shelves.filter((x) => x.eps.length).map(({ s, eps }) => (
    <section>
      <h2><span>[{no(++ch)}]</span> <mark>{s.name}</mark><a href={url(`${s.key}/`)}>ALL ▶</a></h2>
      <div class="cards">
        {eps.map((e, n) => { const c = s.card(e.data); return <a class="card" href={url(`${s.key}/${e.data.num}/`)}><img src={url(c.thumb)} alt="" loading="lazy"><span class="n">{no(n + 1)} &gt;</span> {e.data.title}<small>{c.sub}</small></a>; })}
      </div>
    </section>
  ))}
  {characters.length > 0 && (
    <section id="chars">
      <h2><span>[{no(++ch)}]</span> <mark>PLAYER SELECT</mark></h2>
      <div class="chars">
        {characters.map((c, n) => (
          <div class="chr" id={c.slug && `chr-${c.slug}`}>
            <div class="pic"><span class="p">{n + 1}P</span><img src={url(c.image)} alt={c.name} loading="lazy"></div>
            <p class="name"><mark>{c.name}</mark>{c.tag && <span class="kind">{c.tag}</span>}</p>
            <p>{c.text}</p>
            {c.facts && <dl class="stat">{c.facts.map(([k, v]: string[]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>}
            {c.fanart && <p class="note">{c.fanart.ok} {c.fanart.tags} {c.fanart.note} {c.fanart.link && <a href={url(c.fanart.link)}>{tr("ガイドライン ▶")}</a>}</p>}
            {booksOf(c.slug).length > 0 && <p class="note">{tr("でてくる本")} {booksOf(c.slug).map((b) => <a href={`#${b.id}`}>『{b.title}{b.sub}』</a>)}</p>}
            <p class="links">
              {c.link && <a class="btn" href={url(c.link)}>{tr("▶ よむ")}</a>}
              {c.site && <a class="btn" href={c.site} target="_blank" rel="noopener">{tr("公式サイト ↗")}</a>}
              {c.x && <a class="btn" href={c.x} target="_blank" rel="noopener">X ↗</a>}
            </p>
          </div>
        ))}
      </div>
    </section>
  )}
  {books.length > 0 && (
    <section id="books">
      <h2><span>[{no(++ch)}]</span> <mark>SHOP</mark>{site.store && <a href={site.store} target="_blank" rel="noopener">STORE ↗</a>}</h2>
      <div class="books">
        {books.map((b) => (
          <div class="bk" id={b.id}>
            <img src={url(b.image)} alt={`『${b.title}${b.sub}』の表紙`} loading="lazy">
            <b>{b.title}<br>{b.sub}</b>
            {b.cast.length > 0 && <Cast list={b.cast} size={26} />}
            <span class="yen">¥{b.price.toLocaleString()}</span>
            {site.store && <a class="btn" href={site.store} target="_blank" rel="noopener">{site.storeButton ?? tr("ストアで見る")}</a>}
          </div>
        ))}
      </div>
    </section>
  )}
  {techs.length > 0 && (
    <section>
      <h2><span>[{no(++ch)}]</span> <mark>{site.tech?.label ?? tr("記事")}</mark><a href={url("tech/")}>ALL ▶</a></h2>
      <ul class="lines">{techs.map((p) => <li><span class="d">{dotted(p.data.date)}</span><a href={url(`tech/${p.id}/`)}>{p.data.emoji && `${p.data.emoji} `}{p.data.title}</a></li>)}</ul>
    </section>
  )}
</Base>
