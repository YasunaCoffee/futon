---
// heisei テーマのグループのページ(いくつかの棚をまとめたもの)。props:g(グループ)
import Base from "./Base.astro";
import { episodes, url } from "@futon/lib/content";
const { g } = Astro.props;
const shelves = await Promise.all(g.shelves.map(async (s: any) => ({ s, eps: (await episodes(s.key)).slice(0, 8) })));
---
<Base title={g.name} tab={g.key}>
  <div class="page">
    <p class="crumb"><a href={url("/")}>ホーム</a> ＞ {g.name}</p>
    {g.lead && <p class="lead-p">{g.lead}</p>}
    {shelves.map(({ s, eps }, i) => (
      <div class="box" style="margin-bottom:12px">
        <div class={`bh${i % 2 ? " pink" : ""}`}><span>{s.indexHeading ?? s.name}</span><a href={url(`${s.key}/`)}>ぜんぶ ▶</a></div>
        <div class="bb">
          <p class="lead-p">{s.lead}</p>
          <div class="archive">
            {eps.map((e: any) => { const c = s.card(e.data); return <a href={url(`${s.key}/${e.data.num}/`)}><img src={url(c.thumb)} alt="" loading="lazy">{e.data.title}<span class="s">{c.sub}</span></a>; })}
          </div>
        </div>
      </div>
    ))}
  </div>
</Base>
