---
import Base from "./Base.astro";
import Share from "@futon/components/Share.astro";
import { render } from "astro:content";
import { techPosts, dotted, url, site } from "@futon/lib/content";
import { tr } from "@futon/lib/i18n";
const tech = { label: tr("記事"), tab: tr("きじ"), lead: "", description: "", ...(site.tech ?? {}) }; // 記事の呼び方(site.json の tech)
const { p, newer, older } = Astro.props;
const { Content } = await render(p);
const d = p.data;
---
<Base title={d.title} tab="tech" description={d.description}>
  <div class="page">
    <p class="crumb"><a href={url("/")}>{tr("ホーム")}</a> ＞ <a href={url("tech/")}>{tech.label}</a> ＞ {d.title}</p>
    <article class="box">
      <div class="bh"><span>{tech.label}</span></div>
      <div class="bb">
        <p class="post-emoji" aria-hidden="true">{d.emoji}</p>
        <h1 class="ep-title">{d.title}</h1>
        <p class="ep-meta">{dotted(d.date)}{d.category && ` ／ ${d.category}`}{d.tags?.length ? ` ／ ${d.tags.join("・")}` : ""}</p>
        <div class="prose"><Content /></div>
        <Share text={d.title} />
        <div class="pager">
          {older ? <a class="btn" href={url(`tech/${older.id}/`)}>{tr("◀ まえの記事")}</a> : <span></span>}
          {newer ? <a class="btn" href={url(`tech/${newer.id}/`)}>{tr("つぎの記事 ▶")}</a> : <a class="btn" href={url("tech/")}>{tr("いちらんへ")}</a>}
        </div>
      </div>
    </article>
  </div>
</Base>
