---
import "./site.css";
import { url, site } from "@futon/lib/content";
import { shelfNav } from "@futon/lib/series";
import { hasTech } from "@futon/lib/futon";
import Analytics from "@futon/components/Analytics.astro";
const tech = { label: "記事", tab: "きじ", lead: "", description: "", ...(site.tech ?? {}) }; // 記事の呼び方(site.json の tech)
interface Props { title?: string; description?: string; tab?: string; image?: string }
const { title, description = site.description, tab = "home", image } = Astro.props;
const full = title ? `${title} | ${site.title}` : site.title;
const tabs = [
  ["home", "ホーム", url("/")], ...shelfNav(url),
  ...(hasTech ? [["tech", tech.tab, url("tech/")]] : []),
  ...(site.characters?.length ? [["chars", "キャラクター", url("/#chars")]] : []), ...(site.books?.length ? [["books", "ほん", url("/#books")]] : []),
  ["about", "うんえい", url("about/")],
];
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  {site.noindex && <meta name="robots" content="noindex,nofollow">}
  <title>{full}</title>
  <meta name="description" content={description}>
  <meta property="og:title" content={full}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  {image && <meta property="og:image" content={image}>}
  <link rel="icon" href={url("favicon.svg")} type="image/svg+xml">
  <link rel="alternate" type="application/rss+xml" title={site.title} href={url("rss.xml")}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <Analytics />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mochiy+Pop+P+One&family=Kosugi&family=DotGothic16&display=swap">
</head>
<body>
<div class="site" id="top">
  <header class="hd">
    <a class="logo" href={url("/")} set:html={site.logo} />
    <div class="hello" set:html={site.hello} />
  </header>
  <nav class="tabs" aria-label="メニュー">
    {tabs.map(([k, label, href]) => <a class={tab === k ? "on" : undefined} href={href}>{label}</a>)}
    {site.store && <a href={site.store} target="_blank" rel="noopener">ストア</a>}
  </nav>
  <slot />
  <footer class="ft">
    <nav aria-label="フッター"><a href={url("/")}>ホーム</a>{shelfNav(url).map(([, label, href]) => <a href={href}>{label}</a>)}{hasTech && <a href={url("tech/")}>{tech.tab}</a>}{site.store && <a href={site.store} target="_blank" rel="noopener">ストア</a>}<a href={url("rss.xml")}>RSS</a><a href={url("privacy/")}>このサイトについて</a></nav>
    <small><a href={url("about/")}>運営:{site.owner}</a> ／ このサイトに掲載のイラスト・文章の無断転載を禁じます。<br>{site.copyright}</small>
  </footer>
</div>
</body>
</html>
