---
import "./site.css";
import { url, site, menuNav, extAttrs } from "@futon/lib/content";
import { shelfNav } from "@futon/lib/series";
import { hasTech } from "@futon/lib/futon";
import Analytics from "@futon/components/Analytics.astro";
import { tr, lang } from "@futon/lib/i18n";
const tech = { label: tr("記事"), tab: tr("きじ"), lead: "", description: "", ...(site.tech ?? {}) }; // 記事の呼び方(site.json の tech)
interface Props { title?: string; description?: string; tab?: string; image?: string }
const { title, description = site.description, tab = "home", image } = Astro.props;
const full = title ? `${title} | ${site.title}` : site.title;
const tabs = [
  ["home", tr("ホーム"), url("/")], ...shelfNav(url),
  ...(hasTech ? [["tech", tech.tab, url("tech/")]] : []),
  ...(site.characters?.length ? [["chars", tr("キャラクター"), url("/#chars")]] : []), ...(site.books?.length ? [["books", tr("ほん"), url("/#books")]] : []),
  ["about", tr("うんえい"), url("about/")], ...menuNav(url),
];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  {site.noindex && <meta name="robots" content="noindex,nofollow">}
  <title>{full}</title>
  <meta name="description" content={description}>
  <meta property="og:title" content={full}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  {image && <meta property="og:image" content={image}>}
  <link rel="icon" href={url("favicon.svg")} type="image/svg+xml">
  <link rel="alternate" type="application/rss+xml" title={site.title} href={url("rss.xml")}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <Analytics />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mochiy+Pop+P+One&family=Kosugi&family=DotGothic16&display=swap">
</head>
<body>
<div class="site" id="top">
  <header class="hd">
    <a class="logo" href={url("/")} set:html={site.logo} />
    <div class="hello" set:html={site.hello} />
  </header>
  <nav class="tabs" aria-label={tr("メニュー")}>
    {tabs.map(([k, label, href]) => <a class={tab === k ? "on" : undefined} href={href} {...extAttrs(href)}>{label}</a>)}
    {site.store && <a href={site.store} target="_blank" rel="noopener">{site.storeName ?? tr("ストア")}</a>}
  </nav>
  <slot />
  <footer class="ft">
    <nav aria-label={tr("フッター")}><a href={url("/")}>{tr("ホーム")}</a>{shelfNav(url).map(([, label, href]) => <a href={href}>{label}</a>)}{hasTech && <a href={url("tech/")}>{tech.tab}</a>}{site.store && <a href={site.store} target="_blank" rel="noopener">{site.storeName ?? tr("ストア")}</a>}<a href={url("rss.xml")}>RSS</a><a href={url("privacy/")}>{tr("このサイトについて")}</a></nav>
    <small><a href={url("about/")}>{tr("運営:")}{site.owner}</a> {tr("／ このサイトに掲載のイラスト・文章の無断転載を禁じます。")}<br>{site.copyright}</small>
  </footer>
</div>
</body>
</html>
