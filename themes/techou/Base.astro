---
// techou テーマの外枠。週間の手帳:赤いダブルクリップでとめて、右の小口にインデックスのシール(メニュー)
import "./style.css";
import { url, site, menuNav, extAttrs } from "@futon/lib/content";
import { shelfNav } from "@futon/lib/series";
import { hasTech } from "@futon/lib/futon";
import Analytics from "@futon/components/Analytics.astro";
import { tr, lang } from "@futon/lib/i18n";
import Og from "@futon/components/Og.astro";
interface Props { title?: string; description?: string; tab?: string; image?: string }
const { title, description = site.description, tab = "home", image } = Astro.props;
const full = title ? `${title} | ${site.title}` : site.title;
const nav = [
  ["home", tr("ホーム"), url("/")],
  ...shelfNav(url),
  ...(hasTech ? [["tech", site.tech?.tab ?? tr("記事"), url("tech/")]] : []),
  ...(site.characters?.length ? [["chars", tr("キャラ"), url("/#chars")]] : []),
  ...(site.books?.length ? [["books", tr("本"), url("/#books")]] : []),
  ["about", tr("について"), url("about/")], ...menuNav(url),
];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  {site.noindex && <meta name="robots" content="noindex,nofollow">}
  <title>{full}</title>
  <meta name="description" content={description}>
  <Og title={full} description={description} image={image} />
  <link rel="alternate" type="application/rss+xml" title={site.title} href={url("rss.xml")}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Klee+One:wght@400;600&family=Zen+Kaku+Gothic+New:wght@400;700&family=Barlow+Condensed:wght@500;700&display=swap">
  <Analytics />
</head>
<body>
  <div class="book">
    <i class="clip tl" aria-hidden="true"></i><i class="clip br" aria-hidden="true"></i>
    <header class="top">
      <a class="logo" href={url("/")}>{site.title}</a>
    </header>
    <nav class="index" aria-label={tr("メニュー")}>
      {nav.map(([k, label, href]) => <a class={tab === k ? "on" : undefined} href={href} {...extAttrs(href)}>{label}</a>)}
      {site.store && <a href={site.store} target="_blank" rel="noopener">{site.storeName ?? tr("ストア")}</a>}
    </nav>
    <main class="main"><slot /></main>
    <footer class="ft">
      <nav aria-label={tr("フッター")}><a href={url("rss.xml")}>RSS</a><a href={url("privacy/")}>{tr("このサイトについて")}</a>{site.since && <span>{site.since.label} since {site.since.date}</span>}</nav>
      <small>{site.owner && <>{tr("運営:")}<a href={url("about/")}>{site.owner}</a> ／ </>}{site.copyright}</small>
    </footer>
  </div>
</body>
</html>
