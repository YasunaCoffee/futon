---
import Base from "./Base.astro";
import { url, site } from "@futon/lib/content";
import { tr } from "@futon/lib/i18n";
---
<Base title={tr("ページが見つかりません")} tab="">
  <h1 class="ttl">{tr("ページが見つかりません")}</h1>
  <p class="lead">圏外です(´・ω・`)<br>{tr("このページは、まだ眠っているみたい。")}</p>
  {site.mascot && <img src={url(site.mascot)} alt="" style="width:120px;margin:12px 0">}
  <a class="btn" href={url("/")}>{tr("ホームへ")}</a>
</Base>
