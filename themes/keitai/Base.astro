---
// keitai テーマの外枠。ピンクのガラケー:上に画面(電波・メール・電池、下にソフトキー)、下に数字キー(メニュー)
import "./style.css";
import { url, site, menuNav, extAttrs } from "@futon/lib/content";
import { shelfNav } from "@futon/lib/series";
import { hasTech } from "@futon/lib/futon";
import Analytics from "@futon/components/Analytics.astro";
import { tr, lang } from "@futon/lib/i18n";
interface Props { title?: string; description?: string; tab?: string; image?: string; back?: string }
const { title, description = site.description, tab = "home", image, back } = Astro.props;
const full = title ? `${title} | ${site.title}` : site.title;
const nav = [
  ["home", tr("ホーム"), url("/")],
  ...shelfNav(url),
  ...(hasTech ? [["tech", site.tech?.tab ?? tr("記事"), url("tech/")]] : []),
  ...(site.characters?.length ? [["chars", tr("キャラ"), url("/#chars")]] : []),
  ...(site.books?.length ? [["books", tr("本"), url("/#books")]] : []),
  ["about", tr("について"), url("about/")], ...menuNav(url),
  ...(site.store ? [["store", tr("ストア"), site.store]] : []),
];
// 数字キー:1〜9 にメニューを割り当てる。余ったキーは数字だけ
const keys = Array.from({ length: 9 }, (_, i) => nav[i] ? { n: i + 1, k: nav[i][0], label: nav[i][1], href: nav[i][2] } : { n: i + 1 });
const ext = (h?: string) => !!h && /^https?:/.test(h);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  {site.noindex && <meta name="robots" content="noindex,nofollow">}
  <title>{full}</title>
  <meta name="description" content={description}>
  <meta property="og:title" content={full}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  {image && <meta property="og:image" content={image}>}
  <link rel="alternate" type="application/rss+xml" title={site.title} href={url("rss.xml")}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@800&display=swap">
  <Analytics />
</head>
<body>
  <div class="phone">
    <div class="speaker" aria-hidden="true"><i></i></div>
    <div class="screen">
      <div class="status" aria-hidden="true"><span>Y.ıl ✉</span><span class="bat"><i></i></span></div>
      <header class="hd">
        <a class="logo" href={url("/")}>{site.title}</a>
        {site.hello && <p class="ticker"><span set:html={site.hello} /></p>}
      </header>
      <main class="page"><slot /></main>
      <div class="soft">
        <a href="#keys">{tr("メニュー")}</a>
        <a href={back ?? url("/")}>{tr("もどる")}</a>
      </div>
    </div>
    <nav class="keys" id="keys" aria-label={tr("メニュー")}>
      <div class="top">
        <a class="call ok" href={url("rss.xml")} title="RSS" aria-label="RSS">✉</a>
        <a class="center" href={url("/")} aria-label={tr("ホーム")}>{site.mascot ? <img src={url(site.mascot)} alt=""> : "●"}</a>
        <a class="call end" href={url("about/")} title={tr("について")} aria-label={tr("について")}>☎</a>
      </div>
      <div class="pad">
        {keys.map((x) => x.href
          ? <a class={`key${tab === x.k ? " on" : ""}`} href={x.href} {...(ext(x.href) ? { target: "_blank", rel: "noopener" } : {})}><b>{x.n}</b><span>{x.label}</span></a>
          : <span class="key"><b>{x.n}</b></span>)}
        <span class="key"><b>*</b></span>
        <a class="key" href={url("privacy/")}><b>0</b><span>{tr("このサイト")}</span></a>
        <span class="key"><b>#</b></span>
      </div>
    </nav>
    <footer class="ft">
      <small>{site.owner && <>{tr("運営:")}<a href={url("about/")}>{site.owner}</a> ／ </>}{site.copyright}{site.since && ` ／ ${site.since.label} since ${site.since.date}`}</small>
    </footer>
  </div>
</body>
</html>
