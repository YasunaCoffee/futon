---
// receipt テーマの 404。取り消しのレシート
import Base from "./Base.astro";
import { url } from "@futon/lib/content";
---
<Base title="ページが見つかりません" tab="">
  <h2>取　消</h2>
  <p class="big404">ERROR 404</p>
  <p class="row"><span>このページ</span><span>-¥404</span></p>
  <p>このページは、まだ眠っているみたい。<br>お取引は取り消されました。</p>
  <p><a href={url("/")}>[ホームへ]</a></p>
</Base>
