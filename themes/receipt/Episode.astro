---
// receipt テーマの話のページ。props:s(棚)・e(話)・newer / older
import { tabOf } from "@futon/lib/series";
import Base from "./Base.astro";
import Cast from "./Cast.astro";
import Share from "@futon/components/Share.astro";
import Tweet from "@futon/components/Tweet.astro";
import { dotted, url, castOf } from "@futon/lib/content";
import { tr } from "@futon/lib/i18n";
const { s, e, newer, older } = Astro.props;
const d = e.data;
const p = s.page(d);
const cast = castOf(p.cast);
---
<Base image={p.og} title={p.title} tab={tabOf(s)} description={p.description} doodle={false}>
  <p class="row small"><a href={url(`${s.key}/`)}>{s.name}</a><span>{dotted(d.date)}</span></p>
  <h1 class="h1">{d.title}{p.kind && <small>({p.kind})</small>}</h1>
  <p class="lead">{p.meta}</p>
  <div class="imgs">{p.images.map((i) => <img src={url(i.src)} alt={i.alt}>)}</div>
  {p.kessho && <p class="verse">{p.kessho.lines.map((l, i) => <>{i > 0 && <br />}{l}</>)}<small>{p.kessho.source}</small></p>}
  {cast.length > 0 && <p class="memo">{tr("出演")} <Cast list={cast} size={34} /></p>}
  {d.x && <Tweet url={d.x} note={tr("Xでのようす")} />}
  <Share text={p.share} />
  <p class="row">
    {older ? <a href={url(`${s.key}/${older.data.num}/`)}>{tr("＜ まえ")}</a> : <span></span>}
    {newer ? <a href={url(`${s.key}/${newer.data.num}/`)}>{tr("つぎ ＞")}</a> : <a href={url(`${s.key}/`)}>{tr("いちらん")}</a>}
  </p>
</Base>
